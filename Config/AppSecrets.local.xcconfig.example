// Copy to AppSecrets.local.xcconfig and replace placeholders.
// CRITICAL: In .xcconfig files, // starts a comment everywhere (even in "quoted" URLs).
// So do NOT write https://... directly. Use the SLASH trick below.
//
// After editing: Product → Clean Build Folder, then build.
//
// SwiftUI Previews: Scheme → Run → Environment Variables with same three keys (DEBUG),
// or run the full app.

SLASH = /
SUPABASE_URL = https:$(SLASH)$(SLASH)YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY = REPLACE_WITH_SUPABASE_ANON_KEY
REVENUECAT_API_KEY = REPLACE_WITH_REVENUECAT_PUBLIC_KEY
// Instagram relay: public gist raw JSON {"url":"https://….trycloudflare.com"} — no secret on device
BACKEND_CONFIG_GIST_RAW_URL = https:$(SLASH)$(SLASH)gist.githubusercontent.com$(SLASH)coderBYC$(SLASH)3207f8bef4c8f9248d79563696042c53$(SLASH)raw$(SLASH)backend_config.json
