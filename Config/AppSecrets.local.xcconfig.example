// Copy this file to AppSecrets.local.xcconfig (same folder) and fill in real values.
// AppSecrets.local.xcconfig is gitignored — never commit it.
//
// If these keys ever appeared in git history, rotate them:
// - Supabase: Dashboard → Settings → API → reset anon key (and review RLS).
// - RevenueCat: Project → API keys — use a new public app-specific key if needed.
//
// SUPABASE_URL = https://YOUR_PROJECT_REF.supabase.co
// SUPABASE_ANON_KEY = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
// REVENUECAT_API_KEY = appl_YOUR_PUBLIC_SDK_KEY

SUPABASE_URL = https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY = REPLACE_WITH_SUPABASE_ANON_KEY
REVENUECAT_API_KEY = REPLACE_WITH_REVENUECAT_PUBLIC_KEY
