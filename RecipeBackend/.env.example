# Copy to `.env` in this folder (`cp .env.example .env`). Never commit `.env`.
#
# Recipe video analysis — use OpenAI GPT-5 (recommended) or Gemini:
# RECIPE_AI_PROVIDER=openai
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5
# OPENAI_MODEL_FALLBACKS=gpt-5-mini,gpt-4.1
#
# Gemini (when RECIPE_AI_PROVIDER=gemini or no OPENAI_API_KEY):
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-pro-preview
# GEMINI_MODEL_FALLBACKS=gemini-3.1-flash-lite,gemini-3.5-flash,gemini-2.5-flash
#
# Optional: enforce AI quota, export quota, and profile plan sync (same as production). Leave blank to skip server-side Supabase calls.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
#
# Optional: override port for ./run_local.sh (default 8000).
# PORT=8000
#
# Optional but recommended: absolute base URL used in generated thumbnail URLs.
# - Simulator local: PUBLIC_BASE_URL=http://127.0.0.1:8000
# - Physical phone on LAN: PUBLIC_BASE_URL=http://<your-mac-lan-ip>:8000
# - Render/production: PUBLIC_BASE_URL=https://<your-service>.onrender.com
# PUBLIC_BASE_URL=
#
# Instagram (optional): instaloader session — create USER.session via `instaloader -l USER` in this folder.
# INSTAGRAM_SESSION_USERNAME=
# INSTAGRAM_USER_AGENT=
# Optional: seconds to wait before fetching a reel (0 = no delay). Increase if Instagram rate-limits you.
# INSTAGRAM_PRE_FETCH_DELAY_SEC=0.5
#
# TikTok (optional): global spacing between downloader calls (all users; reduces IP/API throttling).
TIKTOK_MIN_INTERVAL_SECONDS=45
TIKTOK_PRE_FETCH_DELAY_SEC=1
# Free-plan per-user spacing between TikTok imports (HTTP 429 → import job retries).
FREE_TIKTOK_COOLDOWN_SECONDS=60
FREE_INSTAGRAM_COOLDOWN_SECONDS=60
# Free-plan max link/photo imports per UTC day (default 3).
# FREE_IMPORTS_PER_DAY=3
#
# Optional: while Gemini indexes an uploaded video, poll every N seconds (default 3, min 1, max 15).
# GEMINI_FILE_POLL_INTERVAL_SEC=3
# Optional: give up if still PROCESSING after this many seconds (default 600).
# GEMINI_FILE_POLL_MAX_SEC=600
#
